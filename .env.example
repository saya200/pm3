# انسخ هذا الملف إلى .env.local واملأ القيم (لا ترفع .env.local إلى GitHub)

# المسار العشوائي للشعبة: الموقع يعمل على  https://<user>.github.io/<repo>/s/<SECTION_SLUG>/
# أحرف إنجليزية صغيرة وأرقام فقط، ١٠ خانات أو أكثر. غيّره = رابط جديد + بيانات جديدة (انظر README)
SECTION_SLUG=change-me-xk9m2p7q

# مسار المستودع على GitHub Pages (اسم الريبو بين شرطتين). اتركه "/" عند التشغيل المحلي
BASE_PATH=/

# إعدادات مشروع Firebase (Project settings > Your apps > Web app). هذه قيم عامة وليست أسرارًا
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Cloud Messaging > Web Push certificates > Key pair (مفتاح عام)
VITE_FIREBASE_VAPID_KEY=

# للتطوير المحلي فقط: 1 = استخدام Firebase Emulators بدل المشروع الحقيقي
VITE_USE_EMULATORS=0
